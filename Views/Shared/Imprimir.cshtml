@model QuercusPedidos.DetallePedido

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="site.css">
    <script src="script.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>   

<script>
   function imprimir(idPedido) {
    window.print();

    $.ajax({
        type: "POST",
        url: '@Url.Action("ActualizarEstadoPedido", "Pedido")',
        data: { id: idPedido },        
    });
}
</script>

</head>
<body>
    <div class="ticket">
        <p class="centrado">
            QUERCUS REST<br>
            EXPRESS: 8961-7996
        </p>
        <table class="tableim">
            <tr>
                <th class="cantidad">Qt</th>
                <th class="producto">Product</th>
                <th class="precio">₡₡</th>
            </tr>

            @foreach (var datoTablaA in Model.DatosBar)
            {
                <tr>
                    <td class="cantidad">@datoTablaA.Cantidad</td>
                    <td class="producto">@datoTablaA.Nombre</td>
                    <td class="precio">₡@datoTablaA.CostoTotal</td>
                </tr>
            }

            @foreach (var datoTablaB in Model.DatosRes)
            {
                <tr>
                    <td class="cantidad">@datoTablaB.Cantidad</td>
                    <td class="producto">@datoTablaB.Nombre</td>
                    <td class="precio">₡@datoTablaB.CostoTotal</td>
                </tr>
            }


            @foreach (var datoPed in Model.DatosPed)
            {
                <tr class="produc">

                    <td></td>
                    <td class="produc">Subtotal</td>
                    <td>₡<span id="subtotal">@datoPed.SubTotal</span></td>
                </tr>
                <tr class="produc">

                    <td></td>
                    <td class="produc">10% serv</td>
                    <td>₡<span id="impServicio">@datoPed.ImpServicio</span></td>
                </tr>
                <tr class="produc">

                    <td></td>
                    <td class="produc">Total</td>
                    <td>₡<span id="total">@datoPed.MontoTotal</span></td>
                </tr>

            }

        </table>
        <p class="centrado">
            <br />
            ¡GRACIAS POR SU COMPRA!
        </p>
        <button class="oculto-impresion" onclick="imprimir(@Model.DatosPed.First().IdPedido)">Imprimir</button>
        @*<label class="oculto-impresion">
            <input type="checkbox" id="chkServicio" checked />
            Aplicar 10% servicio
        </label>*@
    </div>

    <!-- Recalculo Impuesto de Servicio -->

    @*<script>
        document.addEventListener("DOMContentLoaded", function () {

            const chkServicio = document.getElementById("chkServicio");
            const subtotal = parseFloat(document.getElementById("subtotal").innerText);
            const impServicioSpan = document.getElementById("impServicio");
            const totalSpan = document.getElementById("total");
            const lineaServicio = document.getElementById("lineaServicio");

            chkServicio.addEventListener("change", function () {

                if (chkServicio.checked) {
                    let impuesto = subtotal * 0.10;
                    impServicioSpan.innerText = impuesto.toFixed(0);
                    totalSpan.innerText = (subtotal + impuesto).toFixed(0);
                    lineaServicio.style.display = "block";
                } else {
                    impServicioSpan.innerText = "0";
                    totalSpan.innerText = subtotal.toFixed(0);
                    lineaServicio.style.display = "none";
                }
            });

        });
    </script>*@

</body>
</html>

